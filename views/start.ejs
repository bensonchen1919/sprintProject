<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Development Game</title>
    <script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.10/dist/htmx.min.js"></script>
    <link rel="stylesheet" href="/css/output.css">
</head>
<body class="min-h-screen bg-slate-950 text-slate-100">
    <main class="mx-auto max-w-6xl px-4 py-8 sm:px-8 sm:py-12">
            <nav aria-label="Account controls" class="mb-6 flex justify-end">
                <form action="/logout" method="POST">
                    <button
                        type="submit"
                        class="rounded-lg border border-slate-600 bg-slate-800 px-4 py-2 font-medium text-white transition hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-300"
                    >
                        Log out
                    </button>
                </form>
            </nav>
        <header class="mb-10">
            <% if (typeof player !== "undefined" && player) { %>
                <p class="mb-2 text-sm font-medium uppercase tracking-widest text-indigo-400">
                    Player profile created
                </p>

                <h1 class="text-3xl font-bold tracking-tight sm:text-5xl">
                    Welcome, <%= player.name %>.
                </h1>
            <% } %>

            <h2 class="mt-6 text-2xl font-semibold sm:text-3xl">
                What kind of AI do you want to build?
            </h2>

            <p class="mt-3 max-w-2xl text-slate-300">
                Choose the primary focus of the model you will develop.
            </p>
        </header>

        <ul class="grid gap-5 sm:grid-cols-2">
            <li>
                <a
                    href="/generative"
                    class="block h-full rounded-xl border border-slate-800 bg-slate-900 p-5 transition hover:-translate-y-1 hover:border-indigo-400 hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-400"
                >
                    <strong class="block text-lg text-white">
                        Content Generation
                    </strong>

                    <span class="mt-2 block text-sm text-slate-300">
                        Create text, images, code, audio, and more.
                    </span>
                </a>
            </li>

            <li>
                <a
                    href="/pr"
                    class="block h-full rounded-xl border border-slate-800 bg-slate-900 p-5 transition hover:-translate-y-1 hover:border-indigo-400 hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-400"
                >
                    <strong class="block text-lg text-white">
                        Pattern Recognition &amp; Analysis
                    </strong>

                    <span class="mt-2 block text-sm text-slate-300">
                        Find signals in large datasets and make sense of complex data.
                    </span>
                </a>
            </li>

            <li>
                <a
                    href="/assistant"
                    class="block h-full rounded-xl border border-slate-800 bg-slate-900 p-5 transition hover:-translate-y-1 hover:border-indigo-400 hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-400"
                >
                    <strong class="block text-lg text-white">
                        Personal Assistant
                    </strong>

                    <span class="mt-2 block text-sm text-slate-300">
                        Help a human in real time with tasks, learning, and decisions.
                    </span>
                </a>
            </li>

            <li>
                <a
                    href="/agent"
                    class="block h-full rounded-xl border border-slate-800 bg-slate-900 p-5 transition hover:-translate-y-1 hover:border-indigo-400 hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-400"
                >
                    <strong class="block text-lg text-white">
                        Autonomous Agent
                    </strong>

                    <span class="mt-2 block text-sm text-slate-300">
                        Act independently toward goals with less constant supervision.
                    </span>
                </a>
            </li>
        </ul>

        <% if (typeof player !== "undefined" && player) { %>
            <section
                id="progress-map"
                hx-get="/players/<%= player._id %>/map"
                hx-trigger="load"
                hx-swap="outerHTML"
                class="mt-10 rounded-2xl border border-slate-800 bg-slate-900 p-6"
            >
                <p class="text-slate-300">Loading progress map...</p>
            </section>
        <% } %>
    </main>
</body>
</html>