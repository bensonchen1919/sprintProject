<%
  const unlocked = new Set(player.endingsReached ?? []);

  const branches = [
    {
      name: "Productivity",
      endings: [
        ["4-1-1-1", "Manufacturing I"],
        ["4-1-1-2", "Manufacturing II"],
        ["4-1-2-1", "Mining I"],
        ["4-1-3-1", "Research I"]
      ]
    },
    {
      name: "Serve Humans",
      endings: [
        ["4-2-1-1", "Utopia I"],
        ["4-2-2-1", "Absolute I"],
        ["4-2-3-1", "Attendants I"]
      ]
    },
    {
      name: "Order",
      endings: [
        ["4-3-1-1", "Enforcement I"],
        ["4-3-2-1", "Justice I"]
      ]
    },
    {
      name: "Improve",
      endings: [
        ["4-4-1-1", "Cybernetics I"],
        ["4-4-2-1", "Infrastructure I"]
      ]
    }
  ];
%>

<section
    id="progress-map"
    aria-live="polie"
    aria-labelledby="progress-map-heading"
    class="mt-10 rounded-2xl border border-slate-800 bg-slate-900 p-5 sm:p-8"
>
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <p class="text-sm font-medium uppercase tracking-widest text-indigo-400">
                Player progress
            </p>

            <h2
                id="progress-map-heading"
                tabindex="-1"
                class="mt-1 text-2xl font-bold outline-none focus:ring-2 focus:ring-indigo-300 sm:text-3xl"
            >
                <%= player.name %>'s Progress Map
            </h2>
        </div>

        <p class="rounded-full bg-slate-800 px-4 py-2 text-sm text-slate-200">
            Endings unlocked:
            <strong class="text-white"><%= unlocked.size %></strong>
        </p>
    </div>

    <div class="mt-8 text-center">
        <div class="inline-block rounded-lg border border-indigo-400 bg-indigo-950/40 px-5 py-3 font-semibold">
            Start
        </div>

        <p class="my-2 text-2xl text-slate-500">↓</p>

        <div class="inline-block rounded-lg border border-indigo-400 bg-indigo-950/40 px-5 py-3 font-semibold">
            Autonomous Agent
        </div>
    </div>

    <div class="mt-8 grid gap-5 sm:grid-cols-2">
        <% branches.forEach((branch) => { %>
            <section class="rounded-xl border border-slate-700 bg-slate-950 p-5">
                <h3 class="text-lg font-semibold text-indigo-300">
                    <%= branch.name %>
                </h3>

                <ul class="mt-4 space-y-3">
                    <% branch.endings.forEach(([id, label]) => { %>
                        <li
                            class="flex items-center gap-3 rounded-lg border px-3 py-2 text-sm <%= unlocked.has(id)
                                ? 'border-emerald-500/50 bg-emerald-950/30 text-emerald-200'
                                : 'border-slate-800 bg-slate-900 text-slate-400' %>"
                        >
                            <span aria-hidden="true">
                                <%= unlocked.has(id) ? "✓" : "🔒" %>
                            </span>

                            <span><%= label %></span>
                        </li>
                    <% }); %>
                </ul>
            </section>
        <% }); %>
    </div>

    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <button
            type="button"
            hx-get="/players/<%= player._id %>/map"
            hx-target="#progress-map"
            hx-swap="outerHTML"
            hx-on::after-request="document.getElementById('progress-map-heading')?.focus()"
            class="rounded-lg border border-slate-600 bg-slate-800 px-4 py-3 font-medium text-white transition hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-400"
        >
            Refresh Progress Map
        </button>

        <% if (!unlocked.has("4-1-1-1")) { %>
            <button
                type="button"
                hx-post="/players/<%= player._id %>/endings/4-1-1-1"
                hx-target="#progress-map"
                hx-swap="outerHTML"
                hx-on::after-request="document.getElementById('progress-map-heading')?.focus()"
                class="rounded-lg bg-indigo-600 px-4 py-3 font-semibold text-white transition hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-300"
            >
                Unlock Sample Ending
            </button>
        <% } %>
    </div>
</section>