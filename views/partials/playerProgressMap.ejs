<%
  const unlocked = new Set(player.endingsReached ?? []);

  const branches = [
    {
      name: "Productivity",
      endings: [
        ["4-1-1-1", "Manufacturing I"],
        ["4-1-1-2", "Manufacturing II"],
        ["4-1-2-1", "Mining I"],
        ["4-1-3-1", "Research I"]
      ]
    },
    {
      name: "Serve Humans",
      endings: [
        ["4-2-1-1", "Utopia I"],
        ["4-2-2-1", "Absolute I"],
        ["4-2-3-1", "Attendants I"]
      ]
    },
    {
      name: "Order",
      endings: [
        ["4-3-1-1", "Enforcement I"],
        ["4-3-2-1", "Justice I"]
      ]
    },
    {
      name: "Improve",
      endings: [
        ["4-4-1-1", "Cybernetics I"],
        ["4-4-2-1", "Infrastructure I"]
      ]
    }
  ];
%>

<section id="progress-map">
  <h2><%= player.name %>'s Progress Map</h2>

  <p>
    Endings unlocked:
    <strong><%= unlocked.size %></strong>
  </p>

  <p><strong>Start</strong></p>
  <p>↓</p>
  <p><strong>Autonomous Agent</strong></p>

  <% branches.forEach((branch) => { %>
    <section>
      <h3><%= branch.name %></h3>

      <ul>
        <% branch.endings.forEach(([id, label]) => { %>
          <li>
            <% if (unlocked.has(id)) { %>
              ✓ <%= label %>
            <% } else { %>
              🔒 <%= label %>
            <% } %>
          </li>
        <% }); %>
      </ul>
    </section>
  <% }); %>

  <button
    type="button"
    hx-get="/players/<%= player._id %>/map"
    hx-target="#progress-map"
    hx-swap="outerHTML"
  >
    Refresh Progress Map
  </button>

  <% if (!unlocked.has("4-1-1-1")) { %>
    <button
      type="button"
      hx-post="/players/<%= player._id %>/endings/4-1-1-1"
      hx-target="#progress-map"
      hx-swap="outerHTML"
    >
      Unlock Sample Ending
    </button>
  <% } %>
</section>
