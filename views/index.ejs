<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Development Game</title>
    <link rel="stylesheet" href="/css/output.css">
</head>
<body class="min-h-screen bg-slate-950 text-slate-100">
    <main class="mx-auto flex min-h-screen max-w-2xl items-center px-4 py-10 sm:px-8">

            <nav aria-label="Account controls" class="mb-6 flex justify-end">
                <form action="/logout" method="POST">
                    <button
                        type="submit"
                        class="rounded-lg border border-slate-600 bg-slate-800 px-4 py-2 font-medium text-white transition hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-300"
                    >
                        Log out
                    </button>
                </form>
            </nav>

        <section class="w-full rounded-2xl border border-slate-800 bg-slate-900 p-6 shadow-lg sm:p-10">
            <p class="mb-2 text-sm font-medium uppercase tracking-widest text-indigo-400">
                AI Development Simulation
            </p>

            <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
                Welcome to the AI Development Game
            </h1>

            <p class="mt-4 text-slate-300">
                Enter your name to begin the simulation and track the endings you unlock.
            </p>

            <% if (error) { %>
                <div
                    role="alert"
                    class="mt-6 rounded-lg border border-red-500/50 bg-red-950/40 px-4 py-3 text-red-200"
                >
                    <strong><%= error %></strong>
                </div>
            <% } %>

            <form action="/players" method="POST" class="mt-8 space-y-5">
                <div>
                    <label
                        for="name"
                        class="mb-2 block text-sm font-medium text-slate-200"
                    >
                        Player name
                    </label>

                    <input
                        type="text"
                        id="name"
                        name="name"
                        value="<%= previousName %>"
                        maxlength="30"
                        required
                        autocomplete="name"
                        class="w-full rounded-lg border border-slate-700 bg-slate-950 px-4 py-3 text-base text-white placeholder-slate-500 outline-none transition focus:border-indigo-400 focus:ring-2 focus:ring-indigo-400/30"
                        placeholder="Enter your name"
                    >
                </div>

                <button
                    type="submit"
                    class="w-full rounded-lg bg-indigo-600 px-5 py-3 font-semibold text-white transition hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-300 sm:w-auto"
                >
                    Begin Simulation
                </button>
            </form>
        </section>
    </main>
</body>
</html>