<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Development Game</title>
</head>
<body>
    <h1>Welcome to the AI Development Game</h1>

    <p>Enter your name to begin the simulation.</p>

    <% if (error) { %>
        <p><strong><%= error %></strong></p>
    <% } %>

    <form action="/players" method="POST">
        <label for="name">Player name:</label>

        <input
            type="text"
            id="name"
            name="name"
            value="<%= previousName %>"
            maxlength="30"
            required
        >

        <button type="submit">Begin Simulation</button>
    </form>
</body>
</html>
