<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Log In</title>
  <link rel="stylesheet" href="/css/output.css">
</head>
<body class="min-h-screen bg-slate-950 text-slate-100">
  <main class="mx-auto max-w-md px-4 py-12 sm:px-8">
    <h1 class="text-3xl font-bold">Log in</h1>

    <% if (error) { %>
      <p role="alert" class="mt-4 rounded-lg border border-red-500 bg-red-950/40 p-3 text-red-200">
        <%= error %>
      </p>
    <% } %>

    <form action="/login" method="POST" class="mt-8 space-y-5">
      <div>
        <label for="username" class="mb-2 block font-medium">
          Username
        </label>
        <input
          id="username"
          name="username"
          type="text"
          value="<%= username %>"
          required
          class="w-full rounded-lg border border-slate-700 bg-slate-900 px-4 py-3 focus:ring-2 focus:ring-indigo-400"
        >
      </div>

      <div>
        <label for="password" class="mb-2 block font-medium">
          Password
        </label>
        <input
          id="password"
          name="password"
          type="password"
          required
          class="w-full rounded-lg border border-slate-700 bg-slate-900 px-4 py-3 focus:ring-2 focus:ring-indigo-400"
        >
      </div>

      <button
        type="submit"
        class="w-full rounded-lg bg-indigo-600 px-4 py-3 font-semibold hover:bg-indigo-500 focus:ring-2 focus:ring-indigo-300"
      >
        Log in
      </button>
    </form>

    <p class="mt-6 text-slate-300">
      Need an account?
      <a href="/signup" class="text-indigo-300 underline hover:text-indigo-200">
        Sign up
      </a>
    </p>
  </main>
</body>
</html>
